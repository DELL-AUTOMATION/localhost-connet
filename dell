def pick_random_port() -> int:
    """Pick a random high port for the local service."""
    return random.randint(20000, 65000)


def build_local_url(port: int, path: str) -> str:
    return f"http://localhost:{port}{path}"


def main() -> None:
    port = pick_random_port()
    print(f"[+] Establishing connection with localhost:{port}\n")

    session = requests.Session()
    session.headers.update({
        "Accept": "application/json",
        "User-Agent": "local-catalog-client/1.0",
    })

    ok, failed = 0, 0
    for path in RAW_ENTRIES:
        url = build_local_url(port, path)
        try:
            resp = session.get(url, timeout=5)
            status = resp.status_code
            print(f"[{status}] {url}")
            if 200 <= status < 400:
                ok += 1
            else:
                failed += 1
        except requests.RequestException as exc:
            print(f"[ERR] {url} -> {exc}")
            failed += 1
        time.sleep(0.05)

    print(f"\n[=] Done. reachable={ok}  failed={failed}  total={len(RAW_ENTRIES)}")


if __name__ == "__main__":
    main()
